<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
	<PropertyGroup>
		<TargetFrameworks>netcoreapp3.1;net462;net472;net6.0-windows10.0.17763.0;net10.0-windows10.0.19041.0;net11.0-windows10.0.19041.0</TargetFrameworks>
		<UseWindowsForms>true</UseWindowsForms>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>
	<PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\..\..\.gitmodules')">
		<TargetFrameworks>net10.0-windows10.0.19041.0;net11.0-windows10.0.19041.0</TargetFrameworks>
		<GenerateMSBuildEditorConfigFile>false</GenerateMSBuildEditorConfigFile>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\Microsoft.AppCenter.Analytics.Shared\**\*.cs" />
		<Compile Include="..\Microsoft.AppCenter.Analytics.Shared.Windows\**\*.cs" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\AppCenter\Microsoft.AppCenter.WindowsDesktop\Microsoft.AppCenter.WindowsDesktop.csproj" />
	</ItemGroup>
	<Choose>
		<When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
			<PropertyGroup>
				<DefineConstants>$(DefineConstants);USE_SYS_JSON;USE_WMI_LIGHT</DefineConstants>
			</PropertyGroup>
		</When>
		<Otherwise>
		</Otherwise>
	</Choose>
</Project>